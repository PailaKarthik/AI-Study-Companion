# --- App / runtime ---
NODE_ENV=development

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# --- Database (Neon PostgreSQL + pgvector) ---
# Get from Neon dashboard: https://console.neon.tech
# DATABASE_URL (REQUIRED for API/worker DB access): pooled application
#   connection — use the Neon *pooled* connection string (contains "-pooler").
#   The API and worker use this for all runtime queries.
# DIRECT_URL (REQUIRED for migrations): direct, non-pooled connection to the
#   same database — Prisma uses it for `migrate dev` / `migrate deploy`
#   because pooled connections cannot run DDL transactions reliably.
# Without both set: the API boots degraded and GET /ready reports
#   `database: skipped`; `prisma migrate` and `db seed` will refuse to run.
# Never commit real credentials — copy this file to `.env` and fill it in.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- AI ---
# Groq: https://console.groq.com/keys
# Server only — never NEXT_PUBLIC_*. Without it, the tutor answers 503
# SERVICE_UNAVAILABLE (there is no degraded mode without an LLM) while
# search still works in lexical-only mode.
GROQ_API_KEY=gsk_replace_with_your_groq_key
# Chat model + generation ceilings. The client cannot override these —
# temperature/max tokens come from server config, never request input.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
TUTOR_TIMEOUT_MS=60000
TUTOR_MAX_ATTEMPTS=2
TUTOR_MAX_TOKENS=1024
# Recent turns included in the prompt (oldest dropped first) + evidence
# blocks retrieved per question.
TUTOR_HISTORY_LIMIT=20
TUTOR_RETRIEVAL_LIMIT=6
# Stricter limiter for tutor turns (each can trigger embedding + chat).
TUTOR_RATE_LIMIT_MAX=30
TUTOR_RATE_LIMIT_WINDOW_MS=900000
# --- Adaptive quizzes ---
# Counts are request-bounded (1-20); generation settings live here, never
# in client input (strict schemas reject model/temperature overrides).
QUIZ_MIN_QUESTIONS=1
QUIZ_MAX_QUESTIONS=20
QUIZ_LLM_TIMEOUT_MS=90000
QUIZ_LLM_MAX_ATTEMPTS=2
QUIZ_GENERATION_MAX_TOKENS=4096
# Evidence chunks per concept at generation + chunks sampled for the
# once-per-project concept extraction + bounded regen attempts.
QUIZ_EVIDENCE_CHUNKS=6
QUIZ_CONCEPT_SAMPLE_CHUNKS=30
QUIZ_GENERATION_RETRIES=2
# General quiz limiter + strict generation limiter (extraction + batches).
QUIZ_RATE_LIMIT_MAX=120
QUIZ_RATE_LIMIT_WINDOW_MS=900000
QUIZ_GENERATE_RATE_LIMIT_MAX=10
QUIZ_GENERATE_RATE_LIMIT_WINDOW_MS=900000
# --- Concept mastery / growth / recommendations ---
# Starting weights, not universal truths — see docs/MASTERY.md. Assessment
# evidence (quiz + open-ended) dominates; activity/tutor can never overwhelm it.
MASTERY_QUIZ_WEIGHT=0.45
MASTERY_OPEN_ENDED_WEIGHT=0.35
MASTERY_ACTIVITY_WEIGHT=0.10
MASTERY_TUTOR_WEIGHT=0.10
# Hard cap on one item's effective weight — no single question radically
# changes mastery.
MASTERY_MAX_SINGLE_WEIGHT=0.6
# Recency half-life in days + floor. Old evidence still counts; absence
# never aggressively decays mastery.
MASTERY_RECENCY_HALF_LIFE_DAYS=30
MASTERY_RECENCY_FLOOR=0.4
# Mastery bands: [0, attention) NEEDS_ATTENTION, [attention, developing)
# DEVELOPING, [developing, strong) STABLE, [strong, 1] STRONG.
MASTERY_ATTENTION_BELOW=0.4
MASTERY_DEVELOPING_BELOW=0.65
MASTERY_STRONG_AT=0.8
# Growth: minimum events before a trend classifies (else INSUFFICIENT_DATA),
# half-mean gap that counts as a real move, weak-level cutoff, read cap.
GROWTH_MIN_EVENTS=3
GROWTH_TREND_DELTA=0.05
GROWTH_WEAK_BELOW=0.4
GROWTH_MAX_EVENTS_PER_CONCEPT=20
# Incorrect responses across distinct attempts before a REPEATED_MISTAKE
# learner-context row is written. Single answers never become traits.
MASTERY_REPEATED_MISTAKE_THRESHOLD=3
# Mastery/growth/recommendation reads + lifecycle actions (no LLM, bounded).
MASTERY_RATE_LIMIT_MAX=120
MASTERY_RATE_LIMIT_WINDOW_MS=900000
# Google AI Studio (Gemini embeddings): https://aistudio.google.com/app/apikey
# Server/worker only — never NEXT_PUBLIC_*. Without it, chunk embedding is
# skipped (knowledge stays FAILED-safe) and search degrades to lexical-only.
GEMINI_API_KEY=AIza_replace_with_your_gemini_key
# Embedding model + output width. Width MUST match the pgvector column
# (vector(768)); the provider asserts this on every response.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_ATTEMPTS=4

# --- Knowledge processing (worker) ---
# Deterministic chunking: target tokens per chunk + overlap tokens.
# Tokens are approximated as chars/4 (documented, no tokenizer dep).
KNOWLEDGE_CHUNK_TARGET_TOKENS=700
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=100
# Safety cap: materials with more pages fail loudly instead of truncating.
KNOWLEDGE_MAX_PAGES_PER_JOB=500
# Texts per Gemini batchEmbedContents call.
EMBEDDING_BATCH_SIZE=50
# --- Document pipeline (worker: pdfjs text + tesseract OCR + sharp images) ---
# OCR fallback for pages with fewer chars than the threshold (scanned pages).
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_TEXT_THRESHOLD=50
# Safety caps: oversized documents fail loudly instead of truncating.
DOCUMENT_MAX_PAGES_PER_JOB=500
DOCUMENT_MAX_IMAGES_PER_MATERIAL=50
# Override for <lang>.traineddata dir; default is the vendored
# apps/worker/assets/tessdata (offline — no CDN fetch at runtime).
# (Unset = vendored default; only set to point at a custom install.)
# TESSERACT_LANG_PATH=

# --- Hybrid retrieval (API) ---
# Blending weights (normalized to sum 1 at runtime). Semantic-first is the
# default; tune with evaluation data, not by gut feel.
SEARCH_SEMANTIC_WEIGHT=0.7
SEARCH_LEXICAL_WEIGHT=0.3
# Candidate counts per path; final ranked results capped at RESULT_LIMIT.
SEARCH_SEMANTIC_TOP_K=20
SEARCH_LEXICAL_TOP_K=20
SEARCH_RESULT_LIMIT=8
# Stricter limiter for embedding-triggering endpoints (search + reindex).
SEARCH_RATE_LIMIT_MAX=60
SEARCH_RATE_LIMIT_WINDOW_MS=900000

# --- Background processing (Upstash Redis) ---
# Upstash console: https://console.upstash.com
# NOTE: BullMQ requires a TCP connection via ioredis (rediss://...), NOT the
# @upstash/redis REST client. Use the Redis TCP endpoint + password token.
# See docs/DEVELOPMENT_DECISIONS.md for details.
UPSTASH_REDIS_URL=rediss://default:TOKEN@HOST:6379
UPSTASH_REDIS_TOKEN=replace_with_your_upstash_token
# Optional: full ioredis-compatible URL (e.g. rediss://default:<token>@<host>:6379)
# If set, the worker prefers this over URL+TOKEN composition.
REDIS_URL=rediss://default:TOKEN@HOST:6379

# --- File storage (Neon Object Storage bucket) ---
# PDF bytes + extracted page images live in an S3-compatible bucket in
# your Neon project — NEVER in PostgreSQL (no bytea/base64/JSON blobs).
# Setup: Neon Console → branch → Credentials → create credential with
#   storage:read + storage:write scopes, plus `neon buckets create <name>`
#   (or declare buckets in neon.ts). Docs: https://neon.com/docs/storage
# Where: STORAGE_* + AWS_* below; validated in apps/api/src/config and
#   apps/worker/src/config (production boot fails fast when incomplete).
STORAGE_PROVIDER=neon
# STORAGE_PROVIDER transports: `neon` (default; real bucket) |
#   `memory` (explicit in-process test double) |
#   `redis` (explicit Redis-backed test transport so two-process E2E
#   shares bytes without bucket credentials).
# `memory`/`redis` are refused in production at boot.
STORAGE_BUCKET=your-bucket-name
AWS_ENDPOINT_URL_S3=https://br-rough-silence-b3rof8jj.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=replace_with_your_access_key
AWS_SECRET_ACCESS_KEY=replace_with_your_secret_key
AWS_REGION=ap-southeast-1
# Upload ceiling in bytes (1–50 MB, default 15 MB). Oversized PDFs get a
# controlled 400 before any byte reaches the bucket.
STORAGE_MAX_UPLOAD_BYTES=15728640

# --- Auth / sessions ---
# SESSION_SECRET (REQUIRED in production): HMAC key for session tokens.
#   Must be 32+ unique random chars in production — the API refuses to boot
#   otherwise. Dev default below is for local development only.
SESSION_SECRET=replace_with_32_plus_random_chars
# Session cookie name (valid chars: A-Z a-z 0-9 _ -).
SESSION_COOKIE_NAME=asc_session
# Rolling session lifetime in days (1-90).
SESSION_TTL_DAYS=7
# Cookie SameSite policy: lax (default) | strict | none.
# Use "none" only for cross-site production deployments (forces Secure).
SESSION_SAMESITE=lax
# Credential-endpoint rate limits (requests per window; login is keyed by
# IP + normalized email). Redis-backed with in-memory fallback.
AUTH_REGISTER_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Trusted reverse-proxy hops for Express `trust proxy` (rate-limit IP +
# Secure cookies). Must match the real deployment topology (default 1).
TRUST_PROXY_HOPS=1
# Admin analytics limiter (generous enough for dashboard navigation).
ADMIN_RATE_LIMIT_MAX=300
ADMIN_RATE_LIMIT_WINDOW_MS=900000

# --- Observability ---
# Sentry DSN (optional in development). Backend + frontend + worker share this
# variable unless overridden per-app. Empty = Sentry disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Misc ---
LOG_LEVEL=info
API_CORS_ORIGIN=http://localhost:3000
